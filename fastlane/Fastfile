default_platform(:ios)

WORKSPACE       = "Riot.xcworkspace"
SCHEME          = "Riot"
CONFIGURATION   = "Release"
BUNDLE_ID       = "org.digital.matrix"
ARCHIVE_PATH    = "build/ElementFork.xcarchive"
EXPORT_PATH     = "build/ElementFork"
EXPORT_PLIST    = "fastlane/ExportOptions.plist"

platform :ios do

  desc "Build, archive and upload to TestFlight"
  lane :testflight_upload do

    unless ENV["ASC_KEY_ID"]
      UI.important "ASC_KEY_ID не задан — только сборка без загрузки"
      gym(
        workspace:        WORKSPACE,
        scheme:           SCHEME,
        configuration:    CONFIGURATION,
        clean:            true,
        archive_path:     ARCHIVE_PATH,
        export_method:    "app-store",
        export_options:   EXPORT_PLIST,
        output_directory: EXPORT_PATH,
        output_name:      "ElementFork",
        xcargs:           "CODE_SIGN_STYLE=Manual"
      )
      next
    end

    api_key = app_store_connect_api_key(
      key_id:                ENV["ASC_KEY_ID"],
      issuer_id:             ENV["ASC_ISSUER_ID"],
      key_content:           Base64.decode64(ENV["ASC_KEY_BASE64"]),
      is_key_content_base64: false,
      in_house:              false
    )

    gym(
      workspace:        WORKSPACE,
      scheme:           SCHEME,
      configuration:    CONFIGURATION,
      clean:            true,
      archive_path:     ARCHIVE_PATH,
      export_method:    "app-store",
      export_options:   EXPORT_PLIST,
      output_directory: EXPORT_PATH,
      output_name:      "ElementFork",
      xcargs:           "CODE_SIGN_STYLE=Manual"
    )

    pilot(
      api_key:                           api_key,
      app_identifier:                    BUNDLE_ID,
      ipa:                               "#{EXPORT_PATH}/ElementFork.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission:                   true,
      distribute_external:               false,
      notify_external_testers:           false,
      changelog:                         "CI build ##{ENV['GITHUB_RUN_NUMBER']} from branch #{ENV['GITHUB_REF_NAME']}"
    )
  end

  desc "Archive only"
  lane :archive_only do
    gym(
      workspace:        WORKSPACE,
      scheme:           SCHEME,
      configuration:    CONFIGURATION,
      clean:            true,
      archive_path:     ARCHIVE_PATH,
      export_method:    "app-store",
      export_options:   EXPORT_PLIST,
      output_directory: EXPORT_PATH,
      output_name:      "ElementFork",
      xcargs:           "CODE_SIGN_STYLE=Manual"
    )
  end

end
